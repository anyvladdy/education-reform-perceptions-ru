# Скопируйте в stage2/.env и заполните. Файл .env не попадает в Git.

# Telegram: ключи отдельного исследовательского аккаунта с https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Имя файла сессии в stage2/.secrets/ (создаётся при первом входе)
TG_SESSION=research

# ВКонтакте: токен пользователя (инструкция в stage2/README.md)
VK_TOKEN=

# Соль для псевдонимов авторов: любая длинная случайная строка, не меняйте её между запусками
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
HASH_SALT=

# Необязательно: путь к корневому сертификату российского УЦ для edu.gov.ru
RU_CA_BUNDLE=
